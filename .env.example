APP_ENV=local
LOG_FORMAT=pretty
LOG_FILTER=info,hyperion=debug,sqlx=warn,tungstenite=warn

DATABASE_URL=postgres://postgres:postgres@localhost:5432/hyperion
REDIS_URL=redis://localhost:6379

API_BIND_ADDR=127.0.0.1:8080
INGEST_BIND_ADDR=127.0.0.1:8081
TRADER_ENGINE_BIND_ADDR=127.0.0.1:8082
SIGNAL_ENGINE_BIND_ADDR=127.0.0.1:8083
EXECUTION_ENGINE_BIND_ADDR=127.0.0.1:8084

HYPERLIQUID_WS_URL=wss://api.hyperliquid.xyz/ws
HYPERLIQUID_DEX=
HYPERLIQUID_HEARTBEAT_SECS=15
HYPERLIQUID_RECEIVE_TIMEOUT_SECS=45
HYPERLIQUID_BASE_BACKOFF_SECS=1
HYPERLIQUID_MAX_BACKOFF_SECS=60
HYPERLIQUID_TRACKED_USERS=0x31ca8395cf837de08b24da3f660e77761dfb974b
HYPERLIQUID_TRACKED_COINS=BTC,ETH,SOL
HYPERLIQUID_AGGREGATE_FILL_SNAPSHOTS=false
HYPERLIQUID_SUBSCRIBE_ALL_TRADE_COINS=true
HYPERLIQUID_MAX_TRADE_COINS=1000
HYPERLIQUID_AUTO_DISCOVER_TRADERS=true
HYPERLIQUID_MAX_DISCOVERED_USERS=500

STORAGE_TRADER_LAST_SEEN_UPDATE_SECS=600
STORAGE_MAINTENANCE_INTERVAL_SECS=3600
STORAGE_TRADE_TICKS_RETENTION_DAYS=21
STORAGE_MARKET_SNAPSHOTS_RETENTION_DAYS=45

TRADER_ENGINE_RECALC_INTERVAL_SECS=3600
SIGNAL_ENGINE_RECALC_INTERVAL_SECS=30
SIGNAL_ENGINE_MIN_CONFIRMATIONS=3
SIGNAL_ENGINE_MIN_SCORE=65
SIGNAL_ENGINE_WINDOW_SECS=300
SIGNAL_ENGINE_EXPIRY_MINS=240

EXECUTION_ENGINE_SIM_INTERVAL_SECS=120
EXECUTION_ENGINE_FEE_BPS=4
EXECUTION_ENGINE_SLIPPAGE_BPS=6
EXECUTION_ENGINE_REPLAY_DAYS=7
EXECUTION_ENGINE_STARTING_EQUITY=10000

# Copy-paper dynamic sizing (simulator only)
COPY_USE_DYNAMIC_SIZING=true
EMA_SPAN=20
# 3.5 = durable-edge safety margin over break-even (2.0). Use 5.0 for live shortlist.
EDGE_COST_MULTIPLIER=3.5
MIN_WIN_RATE=0.45
MAX_SIZE_INCREASE_FACTOR=1.05
# Min fraction of FIFO trips that must pass filters (below 30% = unrepresentative subset).
MIN_COPYABILITY=0.30
MIN_TRIPS_DETECTED=20
RISK_PER_TRADE_PCT=0.01
MAX_POSITION_PCT=0.15
MAX_TOTAL_EXPOSURE_PCT=0.50
CIRCUIT_BREAKER_PCT=0.20
MIN_TRADE_USD=1.00
DEFAULT_STOP_PCT=0.03
KELLY_FRACTION=0.25
SHARPE_WINDOW=30
REBALANCE_EVERY_N_TRADES=10

PGADMIN_EMAIL=admin@hyperion.local
PGADMIN_PASSWORD=postgres
